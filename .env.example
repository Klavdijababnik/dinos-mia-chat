# Server-only. Never prefix with NEXT_PUBLIC_ — the key must not reach the browser.
MIKROGRAFIJA_DINOS_API_KEY=

# OpenAI-compatible mIA endpoint
MIA_BASE_URL=https://mia.mikrografija.si/dinos/v1

# Optional. Must stay >= 256 so message.content is populated (model may also return reasoning_content).
MIA_MAX_TOKENS=1024

# Mailto target for »Posreduj operaterju« (not a secret)
OPERATOR_EMAIL=operater@dinos.si
